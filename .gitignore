# ============================================
# AUTOTAREFAS - .gitignore
# ============================================
# Arquivos e pastas ignorados pelo git.
# Codificacao: UTF-8
#
# ATENCAO: este arquivo ja foi corrompido uma vez por um formatador de
# Markdown, que trocou cada `*` por `_` ou `\*`. O efeito e silencioso: as
# linhas continuam parecendo certas e nao ignoram mais nada. Chegou a deixar
# `*.pem` e `*.key` desprotegidos. Se for editar, nao passe este arquivo por
# nenhum formatador de texto.
# ============================================

# === PYTHON ===
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# === AMBIENTES VIRTUAIS ===
venv/
ENV/
env/
.venv/
.env/

# === TESTES E COBERTURA ===
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
coverage.json
coverage.lcov
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# === TYPE CHECKING ===
.mypy_cache/
.dmypy.json
dmypy.json

# === LINTING ===
.ruff_cache/

# === SECURITY SCANNERS ===
.secrets.baseline.bak

# === IDEs ===
# VS Code (mantem configs compartilhadas)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# PyCharm / IntelliJ
.idea/
*.iml
*.ipr
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# === SISTEMA OPERACIONAL ===
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.fuse_hidden*
.directory
.Trash-*
.nfs*

# === LOGS E DADOS LOCAIS ===
*.log
logs/
*.sqlite
*.sqlite3
*.db

# === SECRETS E CONFIGURACOES LOCAIS ===
.env
.env.local
.env.*.local
secrets.yaml
secrets.json
*.pem
*.key

# === ARQUIVOS TEMPORARIOS ===
*.tmp
*.temp
*.bak
*.backup
tmp/
temp/

# === JUPYTER NOTEBOOKS ===
.ipynb_checkpoints/
*.ipynb

# === DOCUMENTACAO ===
site/
docs/_build/
docs/.cache/

# === DADOS DO AUTOTAREFAS (runtime) ===
.autotarefas/
backups/
reports/
data/
screenshots/

# Dashboard gerado pelo comando (output default; nao versionar)
/dashboard.html

# === PLAYWRIGHT (browsers e cache) ===
.playwright/
playwright-report/
test-results/

# === DEPENDENCIAS NODE ===
node_modules/
package-lock.json
yarn.lock
# Preserva o lockfile do frontend Live para npm ci e CI reproduzivel
!apps/web/package-lock.json

# === LIVE SYSTEM (capturador de execucoes) ===
# Saida gerada por examples/capture_runs.py (artefatos locais, nao versionar).
# As copias publicadas ficam em docs/live/assets/ (essas SIM sao versionadas).
examples/output/
emails_recebidos/

# Executavel do Agente (G.10). Dezenas de MB que se refazem em um comando:
# `python tools/construir_agente.py`. No repositorio, incharia o historico para
# sempre.
dist-agente/

# Banco local da plataforma (G.2). Dado de cliente nunca e versionado.
# As linhas `*.db*` acima ja cobrem; estas ficam pelo nome para quem le.
autotarefas.db
autotarefas.db-journal
autotarefas.db-wal
autotarefas.db-shm
