# AutoTarefas - exemplo de configuracao
# Copie para .env somente quando precisar alterar os valores padrao.
# Nunca versione senhas, tokens ou credenciais reais.

# Aplicacao principal
ENVIRONMENT=dev
AUTOTAREFAS_HOME=~/.autotarefas
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# Sistema de demonstracao privado
DEMO_SISTEMA_USUARIO=admin@demo.local
DEMO_SISTEMA_SENHA=
DEMO_SISTEMA_URL=http://localhost:8000

# RPA
RPA_DEFAULT_TIMEOUT=10
RPA_MAX_RETRIES=3
RPA_HEADLESS=true

# Audit
AUDIT_SECRET_KEY=
# O audit nao e expurgado por padrao.
# Defina um prazo somente quando houver uma politica privada aprovada.
# AUDIT_RETENTION_DAYS=365

# Screenshots do modo real privado
SCREENSHOT_RETENTION_DAYS=30
SCREENSHOTS_MASK_SENSITIVE=true

# Limites da aplicacao principal
MAX_FILE_SIZE_MB=100
MAX_RECORDS_PER_RUN=10000

# Live System publico
LIVE_VERSION=0.1.0
PORT=7860
DEMO_SERVERS_AUTOSTART=true
DEMO_PRIMARY_PORT=5555
DEMO_SECONDARY_PORT=5556
DEMO_SMTP_PORT=8025

MAX_UPLOAD_MB=10
MAX_UPLOAD_FILES=50
RUN_TIMEOUT_S=60
RATE_LIMIT_PER_MIN=12
WORKSPACE_TTL_MIN=15
MAX_WORKSPACES=40
MAX_CONCURRENT_RUNS=4
MAX_STREAM_LINES=2000
MAX_STREAM_BYTES=262144
EGRESS_LOCKDOWN=true

# Caminhos opcionais do Live. Se omitidos, os defaults seguros sao usados.
# WORKSPACES_ROOT=C:\caminho\temporario\autotarefas-live
# REPO_ROOT=D:\Projetos\autotarefas

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
