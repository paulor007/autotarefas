# Configuracao do ambiente de DESENVOLVIMENTO do frontend.
#
# Copie para `.env.local` (ignorado pelo git) e ajuste se precisar.
# Em producao nada disto e usado: o backend serve o build na mesma origem e
# as chamadas do front sao relativas (/api/...).

# Para onde o proxy do Vite encaminha /api durante o `npm run dev`.
# Precisa apontar para o backend em execucao. O padrao e a porta canonica do
# projeto (a mesma do config.py, do Dockerfile e do README).
VITE_API_TARGET=http://127.0.0.1:7860

# Porta do servidor de desenvolvimento do Vite.
VITE_DEV_PORT=5173
