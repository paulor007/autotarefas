{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "live-backend",
      "runtimeExecutable": "venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "apps.api.app.main:app",
        "--port",
        "7860"
      ],
      "port": 7860
    },
    {
      "name": "live-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/web", "run", "dev"],
      "port": 5173
    }
  ]
}
